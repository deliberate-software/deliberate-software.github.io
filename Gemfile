source "https://rubygems.org"

# For previewing locally. GitHub Pages ignores this file when it builds the site
# from the branch, so it only needs to run here. This is the same Jekyll version
# GitHub Pages uses (3.10), without the github-pages gem, whose older releases
# don't install on current Ruby.
gem "jekyll", "~> 3.10"
gem "kramdown-parser-gfm"
gem "webrick"

# Part of Ruby's standard library before Ruby 3.4; Jekyll 3 still needs them.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
